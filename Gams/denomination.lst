GAMS 54.2.1  d9889eb3 Jul 13, 2026          WEX-WEI x86 64bit/MS Windows - 08/04/26 23:30:07 Page 1
Denomination puzzle: exact MILP formulation
C o m p i l a t i o n


   2   
      This program implements the formulation with variables
          x(v,k), y(k), p(u,v), tau(v), and w(u,v)
      for an m-by-n king grid.
       
      The two implementation identities
          z(v) = sum(k, x(v,k))
          d(v) = sum(k, ord(k)*x(v,k))
      are included explicitly because z and d are used throughout the model.
       
      Default instance: 3 by 3.
      Examples:
          gams denomination.gms
          gams denomination.gms --M=4 --N=4
          gams denomination.gms --M=4 --N=4 --SOLVER=cplex
       
      The program writes:
          denomination_board.csv
          denomination_sequence.csv
          denomination_arcs.csv
  24   
  25   
  26  options
  27  mip = gurobi,
  28  OptCA = 0,
  29  optcr = 0
  30  ;
  31   
  32   
  33   
  37   
  38   
  39  Sets
  40      c       columns                    / c1*c4 /
  41      r       rows                       / r1*r5 /
  42      k       possible denominations     / k1*k20 /
  43      s       possible placement steps   / s1*s20 /;
  44   
  45  Alias (c,cc), (r,rr);
  46   
  47  Sets
  48      arc(c,r,cc,rr)   both orientations of every king-graph edge
  49      edge(c,r,cc,rr)  one stored orientation of each undirected edge;
  50   
  51  Parameters
  52      cellId(c,r)      lexicographic cell identifier
  53      denomVal(k)      numerical denomination represented by k
  54      delta(c,r)       number of king-graph neighbors
  55      bigM(c,r)        neighborhood big-M value;
  56   
  57  Scalars
  58      numCells         number of cells
  59      Kbar              denomination upper bound;
  60   
  61  numCells   = card(c)*card(r);
  62  Kbar       = card(k);
  63  cellId(c,r)= (ord(c)-1)*card(r) + ord(r);
  64  denomVal(k)= ord(k);
  65   
  66  * Chebyshev distance one gives king adjacency.
  67  arc(c,r,cc,rr) = yes$(
  68      max(abs(ord(c)-ord(cc)),abs(ord(r)-ord(rr))) = 1
  69  );
  70   
  71  * Keep one orientation of each undirected edge for constraints that
  72  * involve p(u,v)+p(v,u).
  73  edge(c,r,cc,rr) = yes$(
  74      arc(c,r,cc,rr) and cellId(c,r) < cellId(cc,rr)
  75  );
  76   
  77  delta(c,r) = sum((cc,rr)$arc(cc,rr,c,r),1);
  78  bigM(c,r)  = Kbar*max(1,delta(c,r));
  79   
  80  Binary Variables
  81      x(c,r,k)         1 if cell CR receives denomination k
  82      y(k)             1 if denomination k appears
  83      p(c,r,cc,rr)     1 if CR and CCRR are occupied and first precedes second;
  84   
  85  Positive Variables
  86      z(c,r)           occupied-cell indicator, defined from x
  87      d(c,r)           denomination at a cell, defined from x
  88      tau(c,r)         ordering potential
  89      w(c,r,cc,rr)     denomination contributed by first cell to second cell;
  90   
  91  Free Variable
  92      objective;
  93   
  94  * Tight bounds and removal of non-edge variables.
  95  z.up(c,r) = 1;
  96  d.up(c,r) = Kbar;
  97  tau.up(c,r) = numCells-1;
  98  w.up(c,r,cc,rr)$arc(c,r,cc,rr) = Kbar;
  99  p.fx(c,r,cc,rr)$(not arc(c,r,cc,rr)) = 0;
 100  w.fx(c,r,cc,rr)$(not arc(c,r,cc,rr)) = 0;
 101   
 102  Equations
 103      objectiveDef
 104      zDefinition(c,r)
 105      dDefinition(c,r)
 106      assignment(c,r)
 107      linkAppear1(c,r,k)
 108      linkAppear2(k)
 109      contiguity(k)
 110      orientation1(c,r,cc,rr)
 111      orientation2(c,r,cc,rr)
 112      orientation3(c,r,cc,rr)
 113      orderBounds(c,r)
 114      acyclicity(c,r,cc,rr)
 115      valueOrder(c,r,cc,rr)
 116      contribution1(c,r,cc,rr)
 117      contribution2(c,r,cc,rr)
 118      contribution3(c,r,cc,rr)
 119      neighborhoodLB(c,r,k)
 120      neighborhoodUB(c,r,k)
 121      nullRule(c,r,cc,rr)
 122      firstDenomination;
 123   
 124  objectiveDef..
 125      objective =e= sum(k,y(k));
 126   
 127  * Definitions used in the article's constraints.
 128  zDefinition(c,r)..
 129      z(c,r) =e= sum(k,x(c,r,k));
 130   
 131  dDefinition(c,r)..
 132      d(c,r) =e= sum(k,denomVal(k)*x(c,r,k));
 133   
 134  * At most one denomination per cell.
 135  assignment(c,r)..
 136      sum(k,x(c,r,k)) =l= 1;
 137   
 138  * y(k)=1 exactly when denomination k appears.
 139  linkAppear1(c,r,k)..
 140      x(c,r,k) =l= y(k);
 141   
 142  linkAppear2(k)..
 143      y(k) =l= sum((c,r),x(c,r,k));
 144   
 145  * Appearing denominations form the prefix 1,...,k_max.
 146  contiguity(k)$(ord(k)>1)..
 147      y(k) =l= y(k-1);
 148   
 149  * Every occupied undirected edge is oriented exactly once;
 150  * an edge incident to an empty cell is not oriented.
 151  orientation1(c,r,cc,rr)$edge(c,r,cc,rr)..
 152      z(c,r) + z(cc,rr) - 1
 153      =l= p(c,r,cc,rr) + p(cc,rr,c,r);
 154   
 155  orientation2(c,r,cc,rr)$edge(c,r,cc,rr)..
 156      p(c,r,cc,rr) + p(cc,rr,c,r) =l= z(c,r);
 157   
 158  orientation3(c,r,cc,rr)$edge(c,r,cc,rr)..
 159      p(c,r,cc,rr) + p(cc,rr,c,r) =l= z(cc,rr);
 160   
 161  * Empty cells have tau=0; occupied cells have tau in [0,N-1].
 162  orderBounds(c,r)..
 163      tau(c,r) =l= (numCells-1)*z(c,r);
 164   
 165  * A selected precedence arc strictly increases the potential.
 166  acyclicity(c,r,cc,rr)$arc(c,r,cc,rr)..
 167      tau(c,r) + 1
 168      =l= tau(cc,rr) + numCells*(1-p(c,r,cc,rr));
 169   
 170  * Along a precedence arc, denomination cannot decrease.
 171  valueOrder(c,r,cc,rr)$arc(c,r,cc,rr)..
 172      d(c,r)
 173      =l= d(cc,rr) + Kbar*(1-p(c,r,cc,rr));
 174   
 175  * Linearization of w(u,v)=d(u)*p(u,v).
 176  contribution1(c,r,cc,rr)$arc(c,r,cc,rr)..
 177      w(c,r,cc,rr) =l= Kbar*p(c,r,cc,rr);
 178   
 179  contribution2(c,r,cc,rr)$arc(c,r,cc,rr)..
 180      w(c,r,cc,rr) =l= d(c,r);
 181   
 182  contribution3(c,r,cc,rr)$arc(c,r,cc,rr)..
 183      w(c,r,cc,rr)
 184      =g= d(c,r) - Kbar*(1-p(c,r,cc,rr));
 185   
 186  * A non-null cell receives exactly the sum of earlier neighbors.
 187  neighborhoodLB(c,r,k)$(ord(k)>1)..
 188      sum((cc,rr)$arc(cc,rr,c,r),w(cc,rr,c,r))
 189      =g= denomVal(k) - bigM(c,r)*(1-x(c,r,k));
 190   
 191  neighborhoodUB(c,r,k)$(ord(k)>1)..
 192      sum((cc,rr)$arc(cc,rr,c,r),w(cc,rr,c,r))
 193      =l= denomVal(k) + bigM(c,r)*(1-x(c,r,k));
 194   
 195  * No occupied neighbor may precede a null stone at the destination cell.
 196  nullRule(c,r,cc,rr)$arc(c,r,cc,rr)..
 197      p(c,r,cc,rr) =l= 1-x(cc,rr,'k1');
 198   
 199  firstDenomination..
 200      y('k1') =e= 1;
 201   
 202  Model denomination / all /;
 203   
 204  option optcr  = 0;
 205  option reslim = 3600;
 206  option limrow = 0;
 207  option limcol = 0;
 208   
 209  Solve denomination using mip maximizing objective;
 210   
 211  * ----------------------------------------------------------------------
 212  * Reconstruct one legal placement sequence.
 213  *
 214  * Cells are ordered first by final denomination, then by tau, and finally
 215  * by cellId.  The value-order and acyclicity constraints ensure that this
 216  * respects every selected precedence arc.  Ordering by denomination also
 217  * enforces the global prerequisite that 1,...,k-1 appear before k.
 218  * ----------------------------------------------------------------------
 219  Sets
 220      occupied(c,r)
 221      remaining(c,r)
 222      candidateD(c,r)
 223      candidateTau(c,r)
 224      chosen(c,r)
 225      placement(s,c,r);
 226   
 227  Parameters
 228      board(c,r)       final denomination
 229      stepOf(c,r)      reconstructed placement step
 230      predecessorSum(c,r)
 231      cellResidual(c,r);
 232   
 233  Scalars
 234      minD
 235      minTau
 236      minId
 237      article3x3Claim
 238      article3x3Match;
 239   
 240  board(c,r)    = round(d.l(c,r));
 241  occupied(c,r) = yes$(z.l(c,r)>0.5);
 242  remaining(c,r)= occupied(c,r);
 243  stepOf(c,r)   = 0;
 244   
 245  loop(s$(card(remaining)>0),
 246      minD = smin((c,r)$remaining(c,r),board(c,r));
 247   
 248      candidateD(c,r) = no;
 249      candidateD(c,r) = yes$(remaining(c,r) and board(c,r)=minD);
 250   
 251      minTau = smin((c,r)$candidateD(c,r),tau.l(c,r));
 252   
 253      candidateTau(c,r) = no;
 254      candidateTau(c,r) = yes$(
 255          candidateD(c,r) and abs(tau.l(c,r)-minTau)<1e-7
 256      );
 257   
 258      minId = smin((c,r)$candidateTau(c,r),cellId(c,r));
 259   
 260      chosen(c,r) = no;
 261      chosen(c,r) = yes$(candidateTau(c,r) and cellId(c,r)=minId);
 262   
 263      placement(s,c,r) = chosen(c,r);
 264      stepOf(c,r)$chosen(c,r) = ord(s);
 265      remaining(c,r)$chosen(c,r) = no;
 266  );
 267   
 268  predecessorSum(c,r) = sum((cc,rr)$(
 269         arc(cc,rr,c,r)
 270     and stepOf(cc,rr)>0
 271     and stepOf(cc,rr)<stepOf(c,r)
 272  ),board(cc,rr));
 273   
 274  cellResidual(c,r)$occupied(c,r) =
 275      predecessorSum(c,r) - board(c,r);
 276  cellResidual(c,r)$(occupied(c,r) and board(c,r)=1) =
 277      predecessorSum(c,r);
 278   
 279  * The article's worked 3-by-3 instance reports k_max=7.
 280  article3x3Claim = 0;
 281  article3x3Claim$((card(c)=3) and (card(r)=3)) = 7;
 282  article3x3Match = 1;
 283  article3x3Match$(article3x3Claim>0) =
 284      abs(objective.l-article3x3Claim)<0.5;
 285   
 286  Display
 287      denomination.modelstat,
 288      denomination.solvestat,
 289      objective.l,
 290      article3x3Claim,
 291      article3x3Match,
 292      delta,
 293      bigM,
 294      board,
 295      stepOf,
 296      tau.l,
 297      predecessorSum,
 298      cellResidual;
 299   
 300  * ----------------------------------------------------------------------
 301  * Machine-readable output files.
 302  * Coordinates follow the article: column increases left-to-right and row
 303  * increases bottom-to-top.
 304  * ----------------------------------------------------------------------
 305  File boardOut / denomination_board.csv /;
 306  put boardOut;
 307  put 'column,row,denomination,tau,placement_step' /;
 308  loop((c,r),
 309      put ord(c):0:0, ',', ord(r):0:0, ',', board(c,r):0:0, ',',
 310          tau.l(c,r):0:6, ',', stepOf(c,r):0:0 /;
 311  );
 312  putclose boardOut;
 313   
 314  File sequenceOut / denomination_sequence.csv /;
 315  put sequenceOut;
 316  put 'step,column,row,denomination,tau,predecessor_sum' /;
 317  loop((s,c,r)$placement(s,c,r),
 318      put ord(s):0:0, ',', ord(c):0:0, ',', ord(r):0:0, ',',
 319          board(c,r):0:0, ',', tau.l(c,r):0:6, ',',
 320          predecessorSum(c,r):0:0 /;
 321  );
 322  putclose sequenceOut;
 323   
 324  File arcOut / denomination_arcs.csv /;
 325  put arcOut;
 326  put 'from_column,from_row,to_column,to_row,from_denomination,contribution' /;
 327  loop((c,r,cc,rr)$(arc(c,r,cc,rr) and p.l(c,r,cc,rr)>0.5),
 328      put ord(c):0:0, ',', ord(r):0:0, ',',
 329          ord(cc):0:0, ',', ord(rr):0:0, ',',
 330          board(c,r):0:0, ',', w.l(c,r,cc,rr):0:0 /;
 331  );
 332  putclose arcOut;


